DLGTEMPLATE IDD_KEYMAP
{
    DIALOG "Key Mapping", IDD_KEYMAP, 32, 32, 260, 74,, FCF_TITLEBAR | FCF_DLGBORDER
        PRESPARAMS PP_FONTNAMESIZE, "8.Helv"
    {
        LTEXT       "Click the box, then click it again with the mouse button to use.", IDC_KM_HINT, 8, 50, 244, 18, DT_WORDBREAK
        LTEXT       "Place a marker",              IDC_KM_LABEL,     8, 32, 124,  8
        ENTRYFIELD  "",                            IDC_KM_ENTRY,   136, 30, 116, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        DEFPUSHBUTTON "OK",                        DID_OK,           8,  6,  76, 14, WS_GROUP
        PUSHBUTTON    "Cancel",                    DID_CANCEL,      92,  6,  76, 14
        PUSHBUTTON    "Default",                   IDC_KM_DEFAULT, 176,  6,  76, 14
    }
}
